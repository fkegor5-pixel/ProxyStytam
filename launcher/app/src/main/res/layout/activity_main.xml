<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:focusable="false">

    <!-- Top bar: clock/date left, pill buttons right -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="32dp"
        android:focusable="false">

        <!-- Left: greeting + clock + date -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:focusable="false">

            <TextView
                android:id="@+id/greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Добрый вечер"
                android:textColor="#AAFFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20:00"
                android:textColor="#FFFFFFFF"
                android:textSize="56sp"
                android:fontFamily="sans-serif-thin" />

            <TextView
                android:id="@+id/date_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Суббота, 25 октября"
                android:textColor="#88FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Right: pill buttons -->
        <LinearLayout
            android:id="@+id/pills"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/pill_inputs"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginEnd="12dp"
                android:text="Входы"
                android:textColor="#DDFFFFFF"
                android:textSize="14sp"
                android:background="@drawable/pill_bg"
                android:focusable="true"
                android:focusableInTouchMode="false" />

            <TextView
                android:id="@+id/pill_wifi"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginEnd="12dp"
                android:text="Wi-Fi"
                android:textColor="#DDFFFFFF"
                android:textSize="14sp"
                android:background="@drawable/pill_bg"
                android:focusable="true"
                android:focusableInTouchMode="false" />

            <TextView
                android:id="@+id/pill_settings"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Настройки"
                android:textColor="#DDFFFFFF"
                android:textSize="14sp"
                android:background="@drawable/pill_bg"
                android:focusable="true"
                android:focusableInTouchMode="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- Focused dock app name with glow -->
    <TextView
        android:id="@+id/dock_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="200dp"
        android:textColor="#EEFFFFFF"
        android:textSize="28sp"
        android:fontFamily="sans-serif-light"
        android:shadowColor="#80FFFFFF"
        android:shadowRadius="24"
        android:visibility="gone" />

    <!-- Dock band at bottom -->
    <FrameLayout
        android:id="@+id/dock_container"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/dock_band_bg"
        android:focusable="false">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dock_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center"
            android:focusable="false" />
    </FrameLayout>

    <!-- App grid (scrolls up when pressing Down from dock) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/apps_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="180dp"
        android:layout_marginBottom="180dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:clipToPadding="false"
        android:paddingBottom="40dp"
        android:visibility="gone"
        android:focusable="false" />

</FrameLayout>
